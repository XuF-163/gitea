# syntax=docker/dockerfile:1
# Zeabur 部署专用 Dockerfile
# 构建前端
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26-alpine3.23 AS frontend-build

RUN apk --no-cache add build-base git nodejs pnpm
WORKDIR /src
COPY package.json pnpm-lock.yaml .npmrc ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
COPY --exclude=.git/ . .
RUN make frontend

# 构建后端
FROM docker.io/library/golang:1.26-alpine3.23 AS build-env

ARG GITEA_VERSION=dev
ARG TAGS="sqlite sqlite_unlock_notify"
ENV TAGS="bindata timetzdata $TAGS"

RUN apk --no-cache add build-base git

WORKDIR ${GOPATH}/src/code.gitea.io/gitea
COPY go.mod go.sum ./
RUN go mod download
COPY --exclude=.git/ . .
COPY --from=frontend-build /src/public/assets public/assets

# 尝试生成版本信息：如果 .git 存在则使用，否则使用 GITEA_VERSION 构建参数
RUN if [ -d .git ]; then \
      make backend; \
    else \
      echo "Warning: .git directory not found, using GITEA_VERSION=${GITEA_VERSION}" && \
      GITEA_VERSION=${GITEA_VERSION} make backend; \
    fi

# 运行时镜像（PaaS 专用，以 root 运行避免权限问题）
FROM docker.io/library/alpine:3.23

EXPOSE 8080

RUN apk --no-cache add \
    bash \
    ca-certificates \
    curl \
    git \
    gnupg \
    tzdata

# 创建数据目录（与 GITEA_CUSTOM 和 app.ini 路径一致）
RUN mkdir -p /data/gitea/custom/conf /data/gitea/data /data/git

# 启动脚本：确保持久化目录存在，如果没有 app.ini 则写入默认配置
RUN cat > /entrypoint.sh << 'ENTRYEOF'
#!/bin/sh
set -e
mkdir -p /data/gitea/custom/conf /data/gitea/data /data/git /data/gitea/log

# 如果 app.ini 不存在，生成默认配置（PaaS 部署用）
if [ ! -f /data/gitea/custom/conf/app.ini ]; then
  cat > /data/gitea/custom/conf/app.ini << 'INIEOF'
[server]
HTTP_PORT = 8080
LOCAL_ROOT_URL = http://localhost:8080/

[repository]
ROOT = /data/gitea/data/repos

[lfs]
PATH = /data/gitea/data/lfs

[attachment]
PATH = /data/gitea/data/attachments

[packages]
PATH = /data/gitea/data/packages

[session]
PROVIDER = file

[log]
ROOT_PATH = /data/gitea/log

[security]
INSTALL_LOCK = false
INIEOF
  echo "Generated default app.ini"
fi

exec gitea web --port 8080
ENTRYEOF
chmod +x /entrypoint.sh

# 复制构建产物
COPY --from=build-env /go/src/code.gitea.io/gitea/gitea /usr/local/bin/gitea

# 设置权限
RUN chmod 755 /usr/local/bin/gitea

ENV GITEA_WORK_DIR=/data/gitea
ENV GITEA_CUSTOM=/data/gitea/custom
ENV GITEA_TEMP=/tmp/gitea
ENV TMPDIR=/tmp/gitea
ENV HOME=/data/git

WORKDIR /data/gitea

# 使用 entrypoint 脚本启动，确保持久化目录存在后再运行 gitea
CMD ["/entrypoint.sh"]

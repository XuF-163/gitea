<h4 class="ui top attached header">
	{{ctx.Locale.Tr "admin.config.backup_config"}}
</h4>
<div class="ui attached segment">
	<p>{{ctx.Locale.Tr "admin.config.backup_config_desc"}}</p>
	<form class="ui form ignore-dirty system-config-form" method="post" action="{{AppSubUrl}}/-/admin/config">
		{{$cfgOpt := $.SystemConfig.Backup.StorageConfig}}
		{{$cfgKey := $cfgOpt.DynKey}}
		{{$storageConfig := .BackupInitialStorageConfig}}
		<input type="hidden" data-config-dyn-key="{{$cfgKey}}" data-config-value-json="{{JsonUtils.EncodeToString $storageConfig}}">

		{{/* 存储类型 */}}
		<div class="field">
			<label>{{ctx.Locale.Tr "admin.config.backup_storage_type"}}</label>
			<select name="{{$cfgKey}}.StorageType" id="backup-storage-type">
				<option value="none" {{if or (eq $storageConfig.StorageType "none") (eq $storageConfig.StorageType "")}}selected{{end}}>{{ctx.Locale.Tr "admin.config.backup_storage_type_none"}}</option>
				<option value="local" {{if eq $storageConfig.StorageType "local"}}selected{{end}}>{{ctx.Locale.Tr "admin.config.backup_storage_type_local"}}</option>
				<option value="webdav" {{if eq $storageConfig.StorageType "webdav"}}selected{{end}}>{{ctx.Locale.Tr "admin.config.backup_storage_type_webdav"}}</option>
			</select>
		</div>

		{{/* 本地路径 */}}
		<div class="field backup-setting-for-local" {{if ne $storageConfig.StorageType "local"}}hidden{{end}}>
			<label>{{ctx.Locale.Tr "admin.config.backup_local_path"}}</label>
			<input type="text" name="{{$cfgKey}}.LocalPath" value="{{$storageConfig.LocalPath}}" placeholder="/data/gitea/backups">
		</div>

		{{/* WebDAV */}}
		<div class="backup-setting-for-webdav" {{if ne $storageConfig.StorageType "webdav"}}hidden{{end}}>
			<div class="field">
				<label>{{ctx.Locale.Tr "admin.config.backup_webdav_url"}}</label>
				<input type="text" name="{{$cfgKey}}.WebDAVURL" value="{{$storageConfig.WebDAVURL}}" placeholder="http://host:port/dav/path">
			</div>
			<div class="field">
				<label>{{ctx.Locale.Tr "admin.config.backup_webdav_username"}}</label>
				<input type="text" name="{{$cfgKey}}.WebDAVUsername" value="{{$storageConfig.WebDAVUsername}}">
			</div>
			<div class="field">
				<label>{{ctx.Locale.Tr "admin.config.backup_webdav_password"}}</label>
				<input type="password" name="{{$cfgKey}}.WebDAVPassword" value="{{$storageConfig.WebDAVPassword}}" autocomplete="off">
			</div>
			<div class="field">
				<label>{{ctx.Locale.Tr "admin.config.backup_webdav_timeout"}}</label>
				<input type="number" name="{{$cfgKey}}.WebDAVTimeout" value="{{$storageConfig.WebDAVTimeout}}" min="0" step="1" data-config-value-type="number">
			</div>
			<div class="field">
				<div class="ui toggle checkbox">
					<input type="checkbox" name="{{$cfgKey}}.WebDAVInsecureSkipVerify" data-config-value-type="boolean" {{if $storageConfig.WebDAVInsecureSkipVerify}}checked{{end}}>
					<label>{{ctx.Locale.Tr "admin.config.backup_webdav_insecure_skip_verify"}}</label>
				</div>
			</div>
		</div>

		<div class="divider"></div>

		{{/* 备份格式 */}}
		{{$cfgOpt = $.SystemConfig.Backup.Format}}
		{{$cfgKey = $cfgOpt.DynKey}}
		{{$format := .BackupInitialFormat}}
		<input type="hidden" data-config-dyn-key="{{$cfgKey}}" data-config-value-json="{{JsonUtils.EncodeToString $format}}">
		<div class="field">
			<label>{{ctx.Locale.Tr "admin.config.backup_format"}}</label>
			<select name="{{$cfgKey}}">
				<option value="zip" {{if eq $format "zip"}}selected{{end}}>zip</option>
				<option value="tar.gz" {{if eq $format "tar.gz"}}selected{{end}}>tar.gz</option>
				<option value="tar.xz" {{if eq $format "tar.xz"}}selected{{end}}>tar.xz</option>
			</select>
		</div>

		<div class="divider"></div>

		{{/* 跳过选项 */}}
		{{$cfgOpt = $.SystemConfig.Backup.SkipLFS}}
		{{$cfgKey = $cfgOpt.DynKey}}
		<dt>{{ctx.Locale.Tr "admin.config.backup_skip_lfs"}}</dt>
		<dd>
			<div class="ui toggle checkbox">
				<input type="checkbox" name="{{$cfgKey}}" data-config-dyn-key="{{$cfgKey}}" data-config-value-type="boolean" {{if $cfgOpt.Value ctx}}checked{{end}}><label></label>
			</div>
		</dd>

		{{$cfgOpt = $.SystemConfig.Backup.SkipAttach}}
		{{$cfgKey = $cfgOpt.DynKey}}
		<dt>{{ctx.Locale.Tr "admin.config.backup_skip_attachments"}}</dt>
		<dd>
			<div class="ui toggle checkbox">
				<input type="checkbox" name="{{$cfgKey}}" data-config-dyn-key="{{$cfgKey}}" data-config-value-type="boolean" {{if $cfgOpt.Value ctx}}checked{{end}}><label></label>
			</div>
		</dd>

		{{$cfgOpt = $.SystemConfig.Backup.SkipPackages}}
		{{$cfgKey = $cfgOpt.DynKey}}
		<dt>{{ctx.Locale.Tr "admin.config.backup_skip_packages"}}</dt>
		<dd>
			<div class="ui toggle checkbox">
				<input type="checkbox" name="{{$cfgKey}}" data-config-dyn-key="{{$cfgKey}}" data-config-value-type="boolean" {{if $cfgOpt.Value ctx}}checked{{end}}><label></label>
			</div>
		</dd>

		<div class="divider"></div>

		<div class="field">
			<button type="button" class="ui button" id="test-backup-storage-btn">{{ctx.Locale.Tr "admin.config.backup_test_connection"}}</button>
			<button class="ui primary button">{{ctx.Locale.Tr "save"}}</button>
		</div>
	</form>
</div>
